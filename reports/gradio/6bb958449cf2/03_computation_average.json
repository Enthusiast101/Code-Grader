  "source_code": "#include <stdio.h>\n\nint main(void) {\n    int count;\n    if (scanf(\"%d\", &count) != 1 || count <= 0) {\n        return 1;\n    }\n\n    long long sum = 0;\n    for (int i = 0; i < count; ++i) {\n        int value;\n        if (scanf(\"%d\", &value) != 1) {\n            return 1;\n        }\n        sum += value;\n    }\n\n    double average = sum / count;\n    printf(\"%.2f\\n\", average);\n    return 0;\n}\n",
