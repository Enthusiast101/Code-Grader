{
  "problem": "Given a connected undirected graph with n vertices numbered 0 to n-1 and m edges, find every critical connection (bridge): an edge whose removal disconnects the graph. Output the number of bridges, then each edge once with smaller endpoint first, sorted lexicographically. Expected time O(V+E), space O(V+E).",
  "problem_contract": {
    "description": "Find every bridge in a connected undirected simple graph. Output each bridge once with smaller endpoint first, sorted lexicographically.",
    "algorithm": "Tarjan DFS low-link bridge detection",
    "required_time_complexity": "O(V + E)",
    "required_space_complexity": "O(V + E)",
    "input_range": "2 <= V <= 100000; V-1 <= E <= 100000; connected simple undirected graph; vertex IDs 0..V-1",
    "output_rule": "First print the number of bridges, then each sorted edge u v on its own line. Print 0 when there are no bridges."
  },
  "time_limit_s": 5,
  "memory_limit_mb": 256,
