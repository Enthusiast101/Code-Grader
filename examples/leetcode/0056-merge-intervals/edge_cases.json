  },
  {
    "id": "duplicates",
    "description": "Identical intervals.",
    "input": "3\n3 6\n3 6\n3 6\n",
    "expected": "1\n3 6\n"
  },
  {
    "id": "points",
    "description": "Zero-length intervals; 5 and 6 do not touch.",
    "input": "3\n5 5\n5 5\n6 6\n",
    "expected": "2\n5 5\n6 6\n"
  },
  {
    "id": "full-range",
