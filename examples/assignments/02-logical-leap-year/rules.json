{
  "problem": "Read one Gregorian calendar year from 1 through 9999. Print LEAP followed by a newline if the year is divisible by 400, or divisible by 4 but not by 100; otherwise print COMMON followed by a newline.",
  "problem_contract": {
    "description": "Classify years according to the Gregorian leap-year rule: divisible by 400, or divisible by 4 and not by 100.",
    "operand_type": "integer year",
    "sum_type": "none",
    "input_range": "1 through 9999",
    "output_rule": "Print LEAP or COMMON followed by a newline."
  },
  "time_limit_s": 2,
  "memory_limit_mb": 256,
  "submission": {
    "language": "c",
    "source_file": "examples/assignments/02-logical-leap-year/submission.c"
  },
