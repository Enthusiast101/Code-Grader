{
  "problem": "Read R and C (1 <= R,C <= 30), followed by an R by C grid whose cells are 0 (open) or 1 (blocked). Count paths from the top-left to the bottom-right using only right and down moves and never entering a blocked cell. If either endpoint is blocked, the answer is zero. Print the path count followed by a newline; it fits in a signed 64-bit integer.",
  "problem_contract": {
    "description": "Count right/down paths from the top-left to bottom-right cell without entering cells marked 1. A blocked start or destination yields zero.",
    "operand_type": "signed 64-bit integers where applicable",
    "sum_type": "signed 64-bit integer where applicable",
    "input_range": "1 <= rows, cols <= 30; each cell is 0 (open) or 1 (blocked); path count fits signed 64-bit.",
    "output_rule": "One signed 64-bit integer: number of valid paths; newline terminated."
  },
  "time_limit_s": 5,
  "memory_limit_mb": 256,
  "submission": {
    "language": "c",
    "source_file": "examples/assignments/09-dp-grid-paths/submission.c"
  },
