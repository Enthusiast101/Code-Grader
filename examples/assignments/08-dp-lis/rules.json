{
  "problem": "Read n (1 <= n <= 20000), followed by n signed 32-bit integers. Print the length of the longest strictly increasing subsequence followed by a newline. A subsequence preserves input order but need not be contiguous; equal values cannot extend it. Use O(n log n) time and O(n) auxiliary memory.",
  "problem_contract": {
    "description": "Return the length of the longest strictly increasing subsequence. Equal adjacent or earlier values cannot extend a strictly increasing subsequence. n is as large as 20,000, so O(n log n) time is required.",
    "operand_type": "signed 64-bit integers where applicable",
    "sum_type": "signed 64-bit integer where applicable",
    "input_range": "1 <= n <= 20000; each array value is a signed 32-bit integer.",
    "output_rule": "One integer: length of the longest strictly increasing subsequence; newline terminated."
  },
  "time_limit_s": 5,
  "memory_limit_mb": 256,
  "submission": {
    "language": "c",
    "source_file": "examples/assignments/08-dp-lis/submission.c"
  },
