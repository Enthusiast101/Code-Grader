{
  "problem": "Read n and target amount A, then n distinct positive integer coin denominations (1 <= n <= 100, 0 <= A <= 100000, each denomination <= 10000). Each denomination may be used an unlimited number of times. Print the minimum number of coins needed to make exactly A, or -1 if it is impossible, followed by a newline. A greedy strategy is not guaranteed to be optimal.",
  "problem_contract": {
    "description": "Find the minimum number of unlimited-use coins that sum exactly to A; return -1 when impossible. Greedy largest-first is not guaranteed to be optimal.",
    "operand_type": "signed 64-bit integers where applicable",
    "sum_type": "signed 64-bit integer where applicable",
    "input_range": "1 <= n <= 100; 0 <= A <= 100000; distinct denominations are in [1, 10000].",
    "output_rule": "One integer: minimum coin count, or -1; newline terminated."
  },
  "time_limit_s": 5,
  "memory_limit_mb": 256,
  "submission": {
    "language": "c",
    "source_file": "examples/assignments/06-dp-coin-change/submission.c"
  },
