{
  "problem": "Without reading input, allocate an integer array, print exactly \"grading sample\" followed by a newline, and exit normally. Keep every allocation valid until its final access and release every successful allocation exactly once; do not read freed memory or leak allocated memory.",
  "problem_contract": {
    "description": "Keep heap data valid until its last use and release every successful allocation exactly once. The program should print the fixed status line and exit normally.",
    "operand_type": "none",
    "sum_type": "none",
    "input_range": "No input.",
    "output_rule": "Print exactly: grading sample"
  },
  "time_limit_s": 2,
  "memory_limit_mb": 256,
  "submission": {
    "language": "c",
    "source_file": "examples/assignments/01-memory-errors/submission.c"
  },
