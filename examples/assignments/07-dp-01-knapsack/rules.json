{
  "problem": "Read n and capacity W, then n positive item weights and n nonnegative item values (1 <= n <= 100, 0 <= W <= 100000, each weight <= 100000, each value <= 1000000000). Choose a subset with total weight at most W that maximizes total value. Each item may be selected at most once. Print the maximum value followed by a newline; use a sufficiently wide integer type for the result.",
  "problem_contract": {
    "description": "Maximize the total value of a subset of items whose total weight is at most W. Every item is selectable at most once; this is 0/1 knapsack, not unbounded knapsack.",
    "operand_type": "signed 64-bit integers where applicable",
    "sum_type": "signed 64-bit integer where applicable",
    "input_range": "1 <= n <= 100; 0 <= W <= 100000; positive weights <= 100000; values are in [0, 10^9].",
    "output_rule": "One signed 64-bit integer: maximum total value; newline terminated."
  },
  "time_limit_s": 5,
  "memory_limit_mb": 256,
  "submission": {
    "language": "c",
    "source_file": "examples/assignments/07-dp-01-knapsack/submission.c"
  },
