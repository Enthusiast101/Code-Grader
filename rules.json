{
  "problem": "sum_two_integers",
  "time_limit_s": 2,
  "memory_limit_mb": 512,
  "submission": {
    "language": "c",
    "source_file": "examples/sum/main.c"
  },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.22,
      "enabled": true,
      "params": {
        "testset_path": "tests/sum/testcases.json"
      }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_diagnostics",
      "weight": 0.08,
      "enabled": true,
      "params": {
        "flags": [
          "-std=c11",
          "-Wall",
          "-Wextra",
          "-Wpedantic"
        ],
        "warning_penalty": 5
      }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.12,
      "enabled": true,
      "params": {
        "timeout_s": 15
      }
    },
    {
      "name": "modularity",
      "analyzer": "modularity",
      "weight": 0.08,
      "enabled": true,
      "params": {
        "expect_helpers": false,
        "min_functions": 1
      }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.08,
      "enabled": true,
      "params": {
        "max_cyclomatic": 8,
        "max_function_length": 40
      }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.1,
      "enabled": true,
      "params": {
        "testset_path": "tests/sum/edge_cases.json"
      }
    },
    {
      "name": "runtime_efficiency",
      "analyzer": "runtime_profile",
      "weight": 0.05,
      "enabled": true,
      "params": {
        "testset_path": "tests/sum/runtime_cases.json",
        "target_runtime_ms": 1000,
        "repetitions": 3
      }
    },
    {
      "name": "memory_safety",
      "analyzer": "memory_safety",
      "weight": 0.17,
      "enabled": true,
      "params": {
        "testset_path": "tests/sum/edge_cases.json",
        "run_sanitizers": true
      }
    },
    {
      "name": "readability",
      "analyzer": "readability",
      "weight": 0.1,
      "enabled": true,
      "params": {
        "max_line_length": 100
      }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.05,
      "enabled": false,
      "params": {
        "corpus_dir": "submissions",
        "flag_threshold": 0.85,
        "max_files": 5000,
        "shingle_size": 5
      }
    }
  ],
  "llm_review": {
    "max_iterations": 3
  },
  "problem_contract": {
    "description": "Read two signed 32-bit integers separated by whitespace and print their mathematical sum followed by a newline.",
    "operand_type": "int32",
    "sum_type": "int64",
    "input_range": "-2147483648 through 2147483647 for each operand",
    "output_rule": "The sum must be printed exactly as a signed 64-bit decimal integer."
  }
}
