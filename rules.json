{
  "problem": "grading",
  "problem_contract": {},
  "time_limit_s": 5,
  "memory_limit_mb": 512,
  "submission": {
    "language": "c",
    "source_file": "submission.c"
  },
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.22,
      "enabled": true,
      "params": {
        "testset_path": null
      }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_diagnostics",
      "weight": 0.08,
      "enabled": true,
      "params": {
        "flags": [
          "-std=c11",
          "-Wall",
          "-Wextra",
          "-Wpedantic"
        ],
        "warning_penalty": 5
      }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.12,
      "enabled": true,
      "params": {
        "timeout_s": 15
      }
    },
    {
      "name": "modularity",
      "analyzer": "modularity",
      "weight": 0.08,
      "enabled": true,
      "params": {
        "expect_helpers": false,
        "min_functions": 1
      }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.08,
      "enabled": true,
      "params": {
        "max_cyclomatic": 8,
        "max_function_length": 40
      }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.1,
      "enabled": true,
      "params": {
        "testset_path": null
      }
    },
    {
      "name": "runtime_efficiency",
      "analyzer": "runtime_profile",
      "weight": 0.05,
      "enabled": true,
      "params": {
        "testset_path": null,
        "target_runtime_ms": 1000,
        "repetitions": 3
      }
    },
    {
      "name": "memory_safety",
      "analyzer": "memory_safety",
      "weight": 0.17,
      "enabled": true,
      "params": {
        "testset_path": null,
        "run_sanitizers": true
      }
    },
    {
      "name": "readability",
      "analyzer": "readability",
      "weight": 0.1,
      "enabled": true,
      "params": {
        "max_line_length": 100
      }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.05,
      "enabled": false,
      "params": {
        "corpus_dir": "submissions",
        "flag_threshold": 0.85,
        "max_files": 5000,
        "shingle_size": 5
      }
    }
  ]
}
